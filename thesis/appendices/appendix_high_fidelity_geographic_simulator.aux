\@writefile{lof}{\contentsline {figure}{\numberline {B.3}{\ignorespaces The \texttt  {electrans} tractor-trailer model. The tractor reuses the AgileX Hunter \texttt  {xacro} description (Ackermann front steering, continuous rear wheels, and \texttt  {ros2\_control} blocks), rescaled and given a cab-over terminal-tractor body mesh. The box trailer is attached through a revolute hitch joint at the tractor rear axle.\relax }}{93}{figure.caption.88}\protected@file@percent }
\newlabel{fig:electrans_model}{{B.3}{93}{The \texttt {electrans} tractor-trailer model. The tractor reuses the AgileX Hunter \texttt {xacro} description (Ackermann front steering, continuous rear wheels, and \texttt {ros2\_control} blocks), rescaled and given a cab-over terminal-tractor body mesh. The box trailer is attached through a revolute hitch joint at the tractor rear axle.\relax }{figure.caption.88}{}}
\newlabel{fig:electrans_model@cref}{{[figure][3][2147483647,2]B.3}{[1][93][]93}}
