\@writefile{lof}{\contentsline {figure}{\numberline {B.1}{\ignorespaces Reconstruction of the target distribution-center site in Blender. OpenStreetMap building footprints are extruded to form the 3D building meshes and draped over high-resolution aerial orthoimagery from the ESRI World Imagery basemap, both layers imported through the Blender GIS plugin. The same GIS-driven procedure reconstructs any real distribution center from its geographic coordinates.\relax }}{91}{figure.caption.86}\protected@file@percent }
\newlabel{fig:geo_sim_blender}{{B.1}{91}{Reconstruction of the target distribution-center site in Blender. OpenStreetMap building footprints are extruded to form the 3D building meshes and draped over high-resolution aerial orthoimagery from the ESRI World Imagery basemap, both layers imported through the Blender GIS plugin. The same GIS-driven procedure reconstructs any real distribution center from its geographic coordinates.\relax }{figure.caption.86}{}}
\newlabel{fig:geo_sim_blender@cref}{{[figure][1][2147483647,2]B.1}{[1][90][]91}}
